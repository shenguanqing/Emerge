{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Emerge 主窗口能力：窗口拖拽等核心权限",
  "windows": [
    "main",
    "settings",
    "welcome"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "autostart:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
