{
  "name": "emerge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "app:build": "tauri build --debug --no-bundle",
    "app:dmg": "tauri build --bundles app,dmg --ci",
    "app:dev": "node scripts/app-dev.mjs",
    "test:core": "node --import tsx --test src/core/*.test.ts",
    "test:audio": "node --import tsx --test src/input/audio-system.test.ts",
    "test:input": "node --import tsx --test src/input/*.test.ts",
    "test:i18n": "node --import tsx --test src/i18n/*.test.ts",
    "test:render": "node --test scripts/shader-interface.test.mjs && node --import tsx --test src/render/backends/*/submission.test.ts"
  },
  "dependencies": {
    "three": "^0.186.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@webgpu/types": "^0.1.74",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^8.3.1",
    "vue-tsc": "^2.1.10"
  }
}
